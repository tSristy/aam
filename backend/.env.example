# ---- Server ----
PORT=5000
NODE_ENV=development            # use "production" when deployed

# ---- Database (MySQL / MariaDB) ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=aamf_cms
# Existing tables created with an old character set (latin1/utf8) are converted
# to utf8mb4 on start-up so Bangla text can be saved. Set to "false" to disable.
# DB_AUTO_CONVERT_CHARSET=true

# ---- Auth ----
# At least 32 random characters.
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
DEFAULT_ADMIN_NAME=AAMF Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
# At least 12 characters. Remove after the first admin has been created.
DEFAULT_ADMIN_PASSWORD=

# ---- URLs ----
# Website origin(s) allowed to call the admin API (comma separated, no trailing slash).
CLIENT_URL=http://localhost:3000
# Public address of THIS backend. Used to build image URLs returned by the API
# (admin previews). Set it when deployed, e.g. https://api.yourdomain.com
# PUBLIC_BASE_URL=https://api.yourdomain.com
# Set to 1 when running behind Nginx / Cloudflare / cPanel proxy.
# TRUST_PROXY=1

# ---- Image uploads (optional) ----
# IMAGE_UPLOAD_MAX_MB=15
# IMAGE_MAX_WIDTH=1920
# IMAGE_MAX_HEIGHT=1920
# IMAGE_WEBP_QUALITY=88
